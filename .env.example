# Rudra Co-Living Environment Variables Example
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Configuration (Supports local, Atlas, or auto-memory fallback in dev)
MONGODB_URI=mongodb://localhost:27017/rudra-coliving

# JWT Secret for Session Cookies
JWT_SECRET=rudra_coliving_jwt_production_secret_key_change_me_in_prod

# AWS S3 Private Storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=rudra-coliving-pg

# SMS / OTP Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+10000000000

# Email Service (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Rudra Co-Living" <your_email@gmail.com>

# Development Mock OTP (set true to simulate OTP in console)
MOCK_OTP_MODE=false
